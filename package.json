{
  "name": "tropa-fight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "identity:create-admin": "node --conditions=react-server --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/create-first-admin.ts",
    "lint": "oxlint app src tests scripts vitest.config.ts next.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{ts,json}\" .prettierrc.json",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{ts,json}\" .prettierrc.json",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.79.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "vitest": "5.0.5"
  }
}
