DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tropa_fight
LOG_LEVEL=info
# Set a unique local random value before using payment webhooks.
PAYMENT_WEBHOOK_SECRET=

# --- Seed de demonstração (`npm run seed:demo`), somente ambiente local ---
# Conta do administrador criado antes com `npm run identity:create-admin`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcionais (descomente para alterar). Padrão: http://localhost:3000.
# SEED_BASE_URL=http://localhost:3000
# Cliente de demonstração. Padrão: cliente.demo@tropafight.local / Tropa#Demo2026.
# SEED_CUSTOMER_EMAIL=
# SEED_CUSTOMER_PASSWORD=

# --- Docker Compose ---
# O Compose lê um arquivo `.env` na raiz (não o `.env.local`). Variáveis opcionais,
# com padrões locais no docker-compose.yml:
# POSTGRES_DB=tropa_fight
# POSTGRES_USER=tropa
# POSTGRES_PASSWORD=
# POSTGRES_HOST_PORT=5433
# APP_HOST_PORT=3000
